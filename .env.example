# Bitrix24
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your-webhook-token/

# App
DEBUG=true

# Secret key for signing JWT tokens (generate: openssl rand -hex 32)
SECRET_KEY=your-secret-key

# JWT token lifetime in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL connection string
# Локально задаётся через docker-compose, в проде — через env сервера/Render
# DATABASE_URL=postgresql://bitrix_user:bitrix_pass@db:5432/bitrix_app

# URL фронтенда (используется для редиректа после Bitrix24 OAuth)
# В проде — публичный URL фронтенда на Render
FRONTEND_URL=https://your-frontend.onrender.com

# Список разрешённых CORS-origins через запятую.
# Если не задан — используется FRONTEND_URL. Если и он не задан — wildcard "*" (без credentials).
# Пример с несколькими доменами: https://app.onrender.com,https://company.bitrix24.ru
CORS_ORIGINS=https://your-frontend.onrender.com
